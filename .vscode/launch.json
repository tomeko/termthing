{
    "version": "0.2.0",
    "configurations": [
        {
            // C# DevKit / dotnet debugger — works on macOS, Windows and Linux.
            // The extension builds the project and picks the right binary automatically.
            "name": "TermThing (Debug)",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/src/TermThing.csproj",
            // Capture SSH trace output in the Debug Console.
            "env": {
                "TRACE": "1"
            }
        },
        {
            // coreclr / OmniSharp-style fallback for environments without C# DevKit.
            // Uses platform-specific binary path overrides.
            "name": "TermThing (coreclr fallback)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/bin/Debug/net10.0/TermThing",
            "windows": {
                "program": "${workspaceFolder}/src/bin/Debug/net10.0/TermThing.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}/src",
            "stopAtEntry": false,
            "console": "internalConsole",
            "env": {
                "TRACE": "1"
            }
        }
    ]
}
