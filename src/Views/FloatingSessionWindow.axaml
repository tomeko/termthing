<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TermThing.Views.FloatingSessionWindow"
        Title="Session"
        RequestedThemeVariant="Dark"
        Width="900" Height="600"
        MinWidth="480" MinHeight="320"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- Active-pane indicator, mirroring the main window: accent border on the
             section holding keyboard focus (SFTP panel vs. terminal). -->
        <Style Selector="Border.pane">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.pane:focus-within">
            <Setter Property="BorderBrush" Value="#0078d4"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Toolbar: session title + Dock Back button -->
        <Grid DockPanel.Dock="Top"
              Background="#1e1e1e"
              ColumnDefinitions="Auto,*,Auto"
              Margin="8,4">
            <materialIcons:MaterialIcon x:Name="TitleIcon"
                                        Grid.Column="0"
                                        Width="16" Height="16"
                                        VerticalAlignment="Center"
                                        Margin="0,0,6,0"/>
            <TextBlock x:Name="TitleText"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       Foreground="#cccccc"
                       FontSize="13"/>
            <Button x:Name="DockBackButton"
                    Grid.Column="2"
                    Content="⤵ Dock Back"
                    Padding="8,3"/>
        </Grid>

        <!-- Content area: optional SFTP panel | splitter | terminal -->
        <Grid x:Name="ContentGrid" ColumnDefinitions="260,4,*">

            <!-- SFTP panel — hidden by default, shown when session has SFTP -->
            <Border Grid.Column="0" Classes="pane">
                <ContentControl x:Name="SftpHost"
                                IsVisible="False"
                                Background="#252526"/>
            </Border>

            <GridSplitter x:Name="SftpSplitter"
                          Grid.Column="1"
                          Background="#444"
                          Width="4"
                          IsVisible="False"
                          ResizeDirection="Columns"
                          DragCompleted="OnSftpSplitterDragCompleted"/>

            <!-- Terminal host -->
            <Border Grid.Column="2" Classes="pane">
                <ContentControl x:Name="TerminalHost"/>
            </Border>
        </Grid>

    </DockPanel>

</Window>
