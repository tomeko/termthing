<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TermThing.Views.DockerMonPanel"
             Background="#1e1e1e">
    <UserControl.Styles>
        <Style Selector="DataGridCell">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </UserControl.Styles>
    <Border BorderBrush="#333" BorderThickness="0,1,0,0">
        <DockPanel>

            <!-- Header strip -->
            <Grid DockPanel.Dock="Top"
                  ColumnDefinitions="Auto,Auto,*,Auto"
                  Background="#252526" Margin="0">
                <TextBlock Grid.Column="0"
                           Text="🐳 Docker"
                           FontSize="11"
                           Foreground="#8be9fd"
                           VerticalAlignment="Center"
                           Margin="8,2,12,2"/>
                <CheckBox x:Name="ShowAllCheck"
                          Grid.Column="1"
                          Content="Show stopped"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="0,0,12,0"/>
                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           FontSize="11"
                           Foreground="OrangeRed"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <Button x:Name="RefreshButton"
                        Grid.Column="3"
                        Content="⟳"
                        FontSize="16"
                        Padding="8,1"
                        Margin="4,2"/>
            </Grid>

            <!-- Container DataGrid -->
            <DataGrid x:Name="ContainersGrid"
                      CanUserSortColumns="True"
                      CanUserResizeColumns="True"
                      SelectionMode="Single"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      FontSize="11">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name"   Binding="{Binding Name}"         Width="160" MinWidth="60"/>
                    <DataGridTextColumn Header="Image"  Binding="{Binding Image}"        Width="200" MinWidth="80"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}"       Width="130" MinWidth="60"/>
                    <DataGridTextColumn Header="Host Ports"      Binding="{Binding HostPorts}"      Width="100" MinWidth="50"/>
                    <DataGridTextColumn Header="Container Ports" Binding="{Binding ContainerPorts}" Width="*"   MinWidth="60"/>
                    <DataGridTemplateColumn Header="Actions" Width="150" CanUserSort="False" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"
                                            VerticalAlignment="Center" Margin="2,0">
                                    <Button Content="⏹"
                                            ToolTip.Tip="Stop"
                                            Padding="4,0"
                                            FontSize="14"
                                            IsEnabled="{Binding NotBusy}"
                                            Click="OnStopClicked"
                                            Tag="{Binding}"/>
                                    <Button Content="🔄"
                                            ToolTip.Tip="Restart"
                                            Padding="4,0"
                                            FontSize="14"
                                            IsEnabled="{Binding NotBusy}"
                                            Click="OnRestartClicked"
                                            Tag="{Binding}"/>
                                    <Button Content="📜"
                                            ToolTip.Tip="Tail logs"
                                            Padding="4,0"
                                            FontSize="14"
                                            Click="OnLogsClicked"
                                            Tag="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

        </DockPanel>
    </Border>
</UserControl>
