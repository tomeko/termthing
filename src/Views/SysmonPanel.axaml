<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TermThing.Views.SysmonPanel"
             Background="#181818"
             Height="24">
    <Border BorderBrush="#333" BorderThickness="0,1,0,0" Padding="8,2">
        <TextBlock x:Name="StatsText"
                   FontFamily="fonts:CascadiaCode#Cascadia Code,Consolas,monospace"
                   FontSize="11"
                   Foreground="#cccccc"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   Text="(stats loading…)"/>
    </Border>
</UserControl>
