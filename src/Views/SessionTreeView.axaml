<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TermThing.Views"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TermThing.Views.SessionTreeView"
             Background="#252526">

    <Panel>
        <TreeView x:Name="SessionTree"
                  DoubleTapped="OnTreeDoubleTapped"
                  Background="Transparent"
                  SelectionMode="Multiple"
                  DragDrop.AllowDrop="True">

            <!-- Bind IsExpanded on each container back to the node model (TwoWay so user toggles are saved). -->
            <TreeView.Styles>
                <Style Selector="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.Styles>

            <TreeView.ItemTemplate>
                <TreeDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding ReadOnlyTooltip}">
                        <materialIcons:MaterialIcon Kind="{Binding IconKindEnum}"
                                                    Width="16" Height="16"
                                                    Foreground="{Binding IconBrush}"
                                                    VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Header}"
                                   Padding="2,1"
                                   VerticalAlignment="Center"
                                   FontStyle="{Binding FontStyle}"/>
                        <TextBlock Text="{Binding ChildCountLabel}"
                                   IsVisible="{Binding ShowChildCount}"
                                   Foreground="#AAAAAA"
                                   FontSize="11"
                                   VerticalAlignment="Center"
                                   Margin="2,0,0,0"/>
                    </StackPanel>
                </TreeDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Overlay canvas for drag-and-drop visual indicators (insert line / drop-into highlight).
             IsHitTestVisible=False so it never intercepts pointer events. -->
        <Canvas x:Name="DropOverlayCanvas" IsHitTestVisible="False"/>
    </Panel>

</UserControl>
