<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TermThing.Views"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="TermThing.Views.MainWindow"
        Title="TermThing"
        RequestedThemeVariant="Dark"
        Width="1200" Height="750"
        MinWidth="800" MinHeight="500"
        KeyDown="OnMainWindowKeyDown">

    <Window.Styles>
        <!-- Active-pane indicator: a subtle accent border on whichever main section
             holds keyboard focus (left pane vs. terminal), so it's clear where typing
             goes. Thickness stays 1 (transparent when unfocused) to avoid layout shift. -->
        <Style Selector="Border.pane">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Border.pane:focus-within">
            <Setter Property="BorderBrush" Value="#0078d4"/>
        </Style>
    </Window.Styles>

    <DockPanel>

        <!-- Top toolbar -->
        <Grid DockPanel.Dock="Top"
              Background="#1e1e1e"
              ColumnDefinitions="Auto,Auto,*,Auto"
              Margin="6,4">

            <!-- New Session split-button -->
            <SplitButton Grid.Column="0"
                         x:Name="NewSessionButton"
                         Content="＋ New Session"
                         Click="OnNewSessionPrimaryClicked"
                         Margin="0,0,6,0">
                <SplitButton.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="🖥  Local…" Click="OnNewLocalClicked"/>
                        <MenuItem Header="🌐  SSH…"   Click="OnNewSshClicked"/>
                        <MenuItem Header="🔌  Serial…" Click="OnNewSerialClicked"/>
                    </MenuFlyout>
                </SplitButton.Flyout>
            </SplitButton>

            <!-- Overflow menu -->
            <Button Grid.Column="1" Content="⋯" Click="OnOverflowClicked">
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Header="Import sessions…"    Click="OnImportClicked"/>
                        <MenuItem Header="Export sessions…"    Click="OnExportClicked"/>
                        <MenuItem Header="Sync from SSH config…" Click="OnSyncSshConfigClicked"/>
                        <Separator/>
                        <MenuItem Header="Manage known hosts…" Click="OnManageKnownHostsClicked"/>
                        <Separator/>
                        <MenuItem Header="Settings…"           Click="OnSettingsClicked"/>
                        <Separator/>
                        <MenuItem Header="Check for updates…"  Click="OnCheckForUpdatesClicked"/>
                        <MenuItem Header="About TermThing…"    Click="OnAboutClicked"/>
                    </MenuFlyout>
                </Button.Flyout>
            </Button>

            <!-- Floating sessions: one chip per session popped out into its own window.
                 Click focuses the window; right-click re-attaches or closes it. -->
            <Grid x:Name="FloatingStrip" Grid.Column="2" ColumnDefinitions="Auto,*"
                  Margin="12,0,8,0" VerticalAlignment="Center" IsVisible="False">
                <Grid.Styles>
                    <Style Selector="Border.floatingChip">
                        <Setter Property="Width" Value="140"/>
                        <Setter Property="Height" Value="26"/>
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="CornerRadius" Value="3"/>
                        <Setter Property="Background" Value="#2D2D30"/>
                        <Setter Property="BorderBrush" Value="#3F3F46"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="Cursor" Value="Hand"/>
                    </Style>
                    <Style Selector="Border.floatingChip:pointerover">
                        <Setter Property="Background" Value="#3E3E42"/>
                        <Setter Property="BorderBrush" Value="#2196F3"/>
                    </Style>
                </Grid.Styles>
                <TextBlock x:Name="FloatingStripLabel" Grid.Column="0"
                           VerticalAlignment="Center" Margin="0,0,6,0"
                           FontSize="12" Foreground="#AAAAAA"/>
                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="FloatingChips" Orientation="Horizontal" Spacing="4"/>
                </ScrollViewer>
            </Grid>

            <!-- Pane controls for the selected tab: TMUX / SESSION, then zoom, close, splits. -->
            <views:PaneToolbar x:Name="PaneToolbar" Grid.Column="3"/>
        </Grid>

        <!-- Body: left pane | splitter | terminal tabs -->
        <Grid x:Name="MainBodyGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <!-- Left pane: Sessions tree / SFTP browser -->
            <Border Grid.Column="0" Classes="pane">
                <TabControl x:Name="LeftTabs"
                            TabStripPlacement="Bottom"
                            Background="#252526">
                    <TabItem Header="Sessions">
                        <views:SessionTreeView x:Name="SessionTree"/>
                    </TabItem>
                    <TabItem Header="SFTP" x:Name="SftpTab">
                        <ContentControl x:Name="SftpPanelHost">
                            <TextBlock Text="No SFTP session active"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontSize="11"/>
                        </ContentControl>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1"
                          Background="#444"
                          ResizeDirection="Columns"
                          DragCompleted="OnSplitterDragCompleted"/>

            <!-- Terminal tabs -->
            <Border Grid.Column="2" Classes="pane">
                <TabControl x:Name="TerminalTabs"
                            TabStripPlacement="Top"
                            SelectionChanged="OnTabSelectionChanged"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
