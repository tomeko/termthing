<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TermThing.Views.SshConnectDialog"
        Title="SSH Connection"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height"
        Width="480">
    <StackPanel Margin="16" Spacing="0">

        <!-- Name (edit mode only) -->
        <StackPanel x:Name="NameRow" IsVisible="False" Margin="0,0,0,6">
            <TextBlock Text="Session name:"/>
            <TextBox x:Name="EditSessionNameTextBox" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Host -->
        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="HostTextBox" Watermark="e.g. 192.168.1.10"/>
        </Grid>

        <!-- Port -->
        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="PortTextBox" Text="22"/>
        </Grid>

        <!-- Username -->
        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Username:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="UsernameTextBox"/>
        </Grid>

        <!-- Secret fields (connect mode only) -->
        <StackPanel x:Name="SecretFieldsPanel" Margin="0,0,0,0">
            <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
                <TextBlock Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="PasswordTextBox" PasswordChar="*"/>
            </Grid>
        </StackPanel>

        <!-- Private key file -->
        <Grid ColumnDefinitions="130,*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Private key file:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="KeyFileTextBox" Watermark="(optional)"/>
            <Button Grid.Column="2" Content="…" Margin="4,0,0,0" Click="OnBrowseKeyClicked"/>
        </Grid>

        <!-- SFTP -->
        <CheckBox x:Name="SftpCheckBox" Content="Enable SFTP browser" Margin="0,0,0,6"/>

        <!-- Jump hosts (edit mode only) -->
        <Border x:Name="JumpHostsSection" IsVisible="False"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="0,1,0,0"
                Margin="0,4,0,6" Padding="0,8,0,0">
            <StackPanel Spacing="6">
                <TextBlock Text="Jump hosts (proxy chain):" FontWeight="SemiBold"/>

                <ListBox x:Name="JumpHostListBox"
                         MaxHeight="140"
                         SelectionMode="Single">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayLabel}"
                                       FontFamily="Cascadia Code,Consolas,monospace"
                                       FontSize="12"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Per-hop action buttons -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="+ Session ref…" Click="OnAddSessionRefClicked"/>
                    <Button Content="+ Inline hop…"  Click="OnAddInlineHopClicked"/>
                    <Button Content="↑"  Width="28" Click="OnMoveHopUpClicked"/>
                    <Button Content="↓"  Width="28" Click="OnMoveHopDownClicked"/>
                    <Button Content="✕"  Width="28" Click="OnRemoveHopClicked"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Save as session (connect mode only) -->
        <StackPanel x:Name="SaveAsSessionRow" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
            <CheckBox x:Name="SaveAsSessionCheckBox" Content="Temporary (don't save)" IsChecked="False"/>
            <TextBox x:Name="SessionNameTextBox" Watermark="Session name" Width="180"
                     IsVisible="{Binding !IsChecked, ElementName=SaveAsSessionCheckBox}"/>
        </StackPanel>

        <!-- Error -->
        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="OrangeRed"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Margin="0,0,0,4"/>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,8,0,0">
            <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClicked" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancelClicked" IsCancel="True"/>
        </StackPanel>

    </StackPanel>
</Window>
