<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TermThing.Views.SshConnectDialog"
        Title="SSH Connection"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height"
        Width="460">
    <Grid Margin="16"
          RowDefinitions="Auto,6,Auto,6,Auto,6,Auto,Auto,6,Auto,6,Auto,6,Auto,8,Auto,Auto"
          ColumnDefinitions="130,*,Auto">

        <!-- Name (edit mode only) -->
        <StackPanel x:Name="NameRow" Grid.Row="0" Grid.ColumnSpan="3" IsVisible="False">
            <TextBlock Text="Session name:"/>
            <TextBox x:Name="EditSessionNameTextBox" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Host:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                 x:Name="HostTextBox" Watermark="e.g. 192.168.1.10"/>

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2"
                 x:Name="PortTextBox" Text="22"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Username:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2"
                 x:Name="UsernameTextBox"/>

        <!-- Secret fields (connect mode only) -->
        <StackPanel x:Name="SecretFieldsPanel" Grid.Row="7" Grid.ColumnSpan="3">
            <Grid ColumnDefinitions="130,*,Auto" Margin="0,6,0,0">
                <TextBlock Grid.Column="0" Text="Password:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Grid.ColumnSpan="2" x:Name="PasswordTextBox" PasswordChar="*"/>
            </Grid>
        </StackPanel>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Private key file:" VerticalAlignment="Center"/>
        <TextBox Grid.Row="9" Grid.Column="1"
                 x:Name="KeyFileTextBox" Watermark="(optional)"/>
        <Button Grid.Row="9" Grid.Column="2"
                Content="…" Margin="4,0,0,0"
                Click="OnBrowseKeyClicked"/>

        <!-- Key passphrase (connect mode only) — lives inside SecretFieldsPanel logically,
             but placed here for layout order; hidden via panel -->
        <Grid Grid.Row="11" Grid.ColumnSpan="3"
              ColumnDefinitions="130,*"
              IsVisible="{Binding !IsVisible, ElementName=NameRow}">
            <TextBlock Grid.Column="0" Text="Key passphrase:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="KeyPassphraseTextBox" PasswordChar="*"/>
        </Grid>

        <CheckBox Grid.Row="13" Grid.ColumnSpan="3"
                  x:Name="SftpCheckBox"
                  Content="Enable SFTP browser"/>

        <!-- Save as session (connect mode only) -->
        <StackPanel x:Name="SaveAsSessionRow" Grid.Row="15" Grid.ColumnSpan="3"
                    Orientation="Horizontal" Spacing="8">
            <CheckBox x:Name="SaveAsSessionCheckBox" Content="Temporary (don't save)" IsChecked="False"/>
            <TextBox x:Name="SessionNameTextBox" Watermark="Session name" Width="180"
                     IsVisible="{Binding !IsChecked, ElementName=SaveAsSessionCheckBox}"/>
        </StackPanel>

        <TextBlock Grid.Row="16" Grid.ColumnSpan="3"
                   x:Name="ErrorTextBlock"
                   Foreground="OrangeRed"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Margin="0,4,0,0"/>

        <StackPanel Grid.Row="16" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="8" Margin="0,8,0,0">
            <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClicked" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancelClicked" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
