<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TermThing.Views.SshConnectDialog"
        Title="SSH Connection"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height"
        Width="480">
    <StackPanel Margin="16" Spacing="0">

        <!-- Name (edit mode only) -->
        <StackPanel x:Name="NameRow" IsVisible="False" Margin="0,0,0,6">
            <TextBlock Text="Session name:"/>
            <TextBox x:Name="EditSessionNameTextBox" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Host -->
        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Host:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="HostTextBox" PlaceholderText="e.g. 192.168.1.10"/>
        </Grid>

        <!-- Port -->
        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Port:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="PortTextBox" Text="22"/>
        </Grid>

        <!-- Session name (connect mode only) -->
        <StackPanel x:Name="SessionNameRow" IsVisible="False" Margin="0,0,0,6">
            <Grid ColumnDefinitions="130,*">
                <TextBlock Grid.Column="0" Text="Session name:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" x:Name="SessionNameTextBox" PlaceholderText="{}{user}@{host}"/>
            </Grid>
        </StackPanel>

        <!-- Username -->
        <Grid ColumnDefinitions="130,*" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Username:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="UsernameTextBox"/>
        </Grid>

        <!-- Private key file -->
        <Grid ColumnDefinitions="130,*,Auto" Margin="0,0,0,6">
            <TextBlock Grid.Column="0" Text="Private key file:" VerticalAlignment="Center"/>
            <TextBox Grid.Column="1" x:Name="KeyFileTextBox" PlaceholderText="(optional)"/>
            <Button Grid.Column="2" Content="…" Margin="4,0,0,0" Click="OnBrowseKeyClicked"/>
        </Grid>

        <!-- Advanced: SFTP / Jump hosts / ProxyCommand -->
        <Expander Header="Advanced" IsExpanded="False" Margin="0,4,0,6">
            <StackPanel Spacing="6" Margin="0,4,0,0">

                <!-- SFTP -->
                <CheckBox x:Name="SftpCheckBox" Content="Enable SFTP browser"/>

                <!-- ProxyCommand -->
                <StackPanel x:Name="ProxyCommandRow" Spacing="2">
                    <TextBlock Text="Proxy command:"/>
                    <TextBox x:Name="ProxyCommandTextBox"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="12"
                             PlaceholderText="e.g. cloudflared access ssh --hostname %h"/>
                    <TextBlock Text="Tokens: %h host, %p port, %r user. Not yet combinable with jump hosts."
                               FontSize="11"
                               Foreground="Gray"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Jump hosts (edit mode only) -->
                <Border x:Name="JumpHostsSection" IsVisible="False"
                        BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderThickness="0,1,0,0"
                        Margin="0,4,0,0" Padding="0,8,0,0">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Jump hosts (proxy chain):" FontWeight="SemiBold"/>

                        <ListBox x:Name="JumpHostListBox"
                                 MaxHeight="140"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayLabel}"
                                               FontFamily="Cascadia Code,Consolas,monospace"
                                               FontSize="12"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Per-hop action buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Button Content="+ Session ref…" Click="OnAddSessionRefClicked"/>
                            <Button Content="+ Inline hop…"  Click="OnAddInlineHopClicked"/>
                            <Button Content="↑"  Width="28" Click="OnMoveHopUpClicked"/>
                            <Button Content="↓"  Width="28" Click="OnMoveHopDownClicked"/>
                            <Button Content="✕"  Width="28" Click="OnRemoveHopClicked"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Expander>

        <!-- Save as session (connect mode only) -->
        <StackPanel x:Name="SaveAsSessionRow" IsVisible="False" Margin="0,0,0,0">
            <!-- placeholder — row kept for IsVisible toggling; actual controls are in action row -->
        </StackPanel>

        <!-- Error -->
        <TextBlock x:Name="ErrorTextBlock"
                   Foreground="OrangeRed"
                   TextWrapping="Wrap"
                   IsVisible="False"
                   Margin="0,0,0,4"/>

        <!-- Action buttons row: Save-Session toggle left, Connect/Cancel right -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <ToggleSwitch x:Name="SaveSessionToggle"
                          Grid.Column="0"
                          Content="Save Session"
                          IsChecked="True"
                          VerticalAlignment="Center"
                          IsVisible="False"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClicked" IsDefault="True"/>
                <Button x:Name="SaveButton"    Content="Save"    Click="OnSaveClicked"    IsVisible="False"/>
                <Button Content="Cancel" Click="OnCancelClicked" IsCancel="True"/>
            </StackPanel>
        </Grid>

    </StackPanel>
</Window>
