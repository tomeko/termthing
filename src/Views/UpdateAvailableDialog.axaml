<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TermThing.Views"
        x:Class="TermThing.Views.UpdateAvailableDialog"
        Title="Update Available"
        Width="600"
        Height="520"
        MinWidth="400"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   x:Name="HeadlineText"
                   FontWeight="SemiBold"
                   FontSize="14"
                   Margin="0,0,0,8"/>

        <!-- Progress bar (hidden until Install is clicked) -->
        <ProgressBar Grid.Row="1"
                     x:Name="InstallProgress"
                     Minimum="0" Maximum="1"
                     Height="6"
                     Margin="0,0,0,8"
                     IsVisible="False"/>

        <!-- Release notes (every release since the running version, newest first) -->
        <Border Grid.Row="2"
                BorderBrush="#444444"
                BorderThickness="1"
                CornerRadius="4"
                Margin="0,0,0,12">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <views:ReleaseNotesView x:Name="ReleaseNotes" Margin="12,10"/>
            </ScrollViewer>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <TextBlock x:Name="StatusText"
                       VerticalAlignment="Center"
                       Foreground="OrangeRed"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       MaxWidth="280"/>
            <Button x:Name="InstallButton"
                    Content="Install"
                    Click="OnInstallClicked"
                    IsDefault="True"/>
            <Button Content="Later"
                    Click="OnLaterClicked"
                    IsCancel="True"/>
            <Button Content="Skip this version"
                    Click="OnSkipClicked"/>
        </StackPanel>

    </Grid>
</Window>
