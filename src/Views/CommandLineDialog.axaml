<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TermThing.Views.CommandLineDialog"
        Title="Start Process"
        Width="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        SizeToContent="Height">
    <Grid Margin="16" RowDefinitions="Auto,8,Auto,16,Auto">
        <TextBlock Grid.Row="0" Text="Enter the command line to run:"/>
        <TextBox Grid.Row="2"
                 x:Name="CommandLineTextBox"
                 Watermark="e.g., cmd.exe or /bin/bash"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Start" Click="OnStartClicked" IsDefault="True"/>
            <Button Content="Cancel" Click="OnCancelClicked" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
