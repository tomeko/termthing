<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TermThing.Views"
             x:Class="TermThing.Views.SftpFileBrowserView"
             Background="#1e1e1e">
    <UserControl.Styles>
        <!-- Drop-target row highlight: applied when IsDropTarget is True on the entry -->
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow.dropTarget">
            <Setter Property="Background" Value="#552196F3"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,4,4,2">
            <TextBox x:Name="PathBox" Grid.Column="0" FontSize="11" Watermark="Path"
                     KeyDown="OnPathBoxKeyDown" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="⟳" FontSize="16"
                    Padding="6,2" Margin="4,0,0,0" Click="OnRefreshClicked"
                    VerticalAlignment="Center"/>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Margin="6,2,4,4"
                    Spacing="4">
            <CheckBox x:Name="FollowLocationCheckBox"
                      Content="Follow location"
                      IsChecked="True"
                      FontSize="11"
                      IsCheckedChanged="OnFollowLocationChecked"/>
            <Button x:Name="SyncToTerminalButton"
                    Content="⤴"
                    FontSize="13"
                    Padding="4,1"
                    ToolTip.Tip="cd into this folder in the terminal"
                    IsVisible="False"
                    Click="OnSyncToTerminalClicked"/>
        </StackPanel>

        <StackPanel x:Name="MonitorChecksRow"
                    DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    Margin="6,0,4,0"
                    Spacing="10">
            <CheckBox x:Name="DockerMonCheckBox"
                      Content="DockerMon"
                      FontSize="11"
                      ToolTip.Tip="Show running Docker containers in a panel below the terminal"
                      IsCheckedChanged="OnDockerMonCheckedChanged"/>
            <CheckBox x:Name="SysmonCheckBox"
                      Content="Sysmon"
                      FontSize="11"
                      ToolTip.Tip="Show CPU/memory/load stats below the terminal"
                      IsCheckedChanged="OnSysmonCheckedChanged"/>
        </StackPanel>

        <!-- Transfer progress overlay -->
        <views:TransferProgressOverlay x:Name="TransferOverlay" DockPanel.Dock="Bottom"/>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   FontSize="10"
                   Foreground="OrangeRed"
                   Margin="6,0,4,1"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="False"/>

        <!-- Main content: bookmarks header top, body, splitter, file list grows -->
        <Grid x:Name="MainContentGrid" RowDefinitions="*,Auto,Auto">
            <!-- Row 0: DataGrid + upload overlay -->
            <Grid Grid.Row="0">
        <DataGrid x:Name="FilesGrid"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  HorizontalScrollBarVisibility="Auto"
                  FontSize="12"
                  LoadingRow="OnFilesGridLoadingRow"
                  DoubleTapped="OnFilesGridDoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu Opening="OnContextMenuOpening">
                    <MenuItem x:Name="MenuOpen"       Header="Open"          Click="OnMenuOpenClicked"/>
                    <MenuItem x:Name="MenuOpenWith"   Header="Open With"/>
                    <MenuItem x:Name="MenuTail"       Header="Tail (live)"   Click="OnMenuTailClicked"/>
                    <MenuItem x:Name="MenuDownloadTo" Header="Download to "/>
                    <MenuItem x:Name="MenuDelete"     Header="Delete"        Click="OnMenuDeleteClicked"/>
                    <Separator/>
                    <MenuItem x:Name="MenuProperties" Header="Properties"    Click="OnMenuPropertiesClicked"/>
                    <MenuItem x:Name="MenuBookmarkFolder" Header="Bookmark this folder" Click="OnMenuBookmarkFolderClicked"/>
                    <Separator/>
                    <MenuItem Header="Refresh" Click="OnRefreshClicked"/>
                    <Separator x:Name="BlankAreaSeparator"/>
                    <MenuItem x:Name="MenuNewDirectory" Header="New Directory…" Click="OnMenuNewDirectoryClicked"/>
                    <MenuItem x:Name="MenuNewFile"      Header="New File…"      Click="OnMenuNewFileClicked"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="26" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TypeIcon}" Width="22" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13" Padding="0"
                                       Foreground="{Binding IconForeground}"
                                       Opacity="{Binding IconOpacity}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" MinWidth="60"
                                    CanUserSort="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="60" MinWidth="40"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="120" MinWidth="60"/>
                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}"
                                    Width="84" MinWidth="40" FontFamily="Cascadia Code,Consolas,monospace"/>
                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="50" MinWidth="30"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupDisplay}" Width="50" MinWidth="30"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Semi-transparent blue overlay shown when dragging files from OS over the non-folder area -->
        <Border x:Name="DropOverlay"
                Background="#402196F3"
                IsHitTestVisible="False"
                IsVisible="False">
            <TextBlock Text="+"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="64"
                       Foreground="#A02196F3"
                       FontWeight="Bold"/>
        </Border>
            </Grid>

            <!-- Row 1: GridSplitter (hidden when bookmarks panel is collapsed) -->
            <GridSplitter x:Name="BookmarkSplitter"
                          Grid.Row="1"
                          Height="4"
                          Background="#3a3a3a"
                          ResizeDirection="Rows"
                          HorizontalAlignment="Stretch"
                          IsVisible="False"
                          DragCompleted="OnBookmarkSplitterDragCompleted"/>

            <!-- Row 2: Bookmarks section — header (always visible) + body (hidden when collapsed) -->
            <Grid Grid.Row="2" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="#252525" MinHeight="28" Cursor="Hand"
                        Tapped="OnBookmarksHeaderTapped">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock x:Name="BookmarksArrow"
                                   Grid.Column="0"
                                   Text="&#x25BA;"
                                   FontSize="10"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="BookmarksHeaderText"
                                   Grid.Column="1"
                                   Text="Bookmarks"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="BookmarksBody"
                              IsVisible="False"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="BookmarksListPanel"/>
                </ScrollViewer>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>
