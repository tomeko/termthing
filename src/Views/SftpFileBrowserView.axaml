<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TermThing.Views"
             x:Class="TermThing.Views.SftpFileBrowserView"
             Background="#1e1e1e">
    <UserControl.Styles>
        <Style Selector="DataGridCell">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- Drop-target row highlight: applied when IsDropTarget is True on the entry -->
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="DataGridRow.dropTarget">
            <Setter Property="Background" Value="#552196F3"/>
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,4,4,2">
            <TextBox x:Name="PathBox" Grid.Column="0" FontSize="11" Watermark="Path"
                     KeyDown="OnPathBoxKeyDown" VerticalAlignment="Center"/>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="⟳" FontSize="13"
                    Padding="6,2" Margin="4,0,0,0" Click="OnRefreshClicked"
                    VerticalAlignment="Center"/>
        </Grid>

        <CheckBox x:Name="FollowLocationCheckBox"
                  DockPanel.Dock="Bottom"
                  Content="Follow location"
                  IsChecked="True"
                  FontSize="11"
                  Margin="6,2,4,4"
                  Checked="OnFollowLocationChecked"/>

        <!-- Transfer progress overlay -->
        <views:TransferProgressOverlay x:Name="TransferOverlay" DockPanel.Dock="Bottom"/>

        <TextBlock x:Name="StatusText"
                   DockPanel.Dock="Bottom"
                   FontSize="10"
                   Foreground="OrangeRed"
                   Margin="6,0,4,1"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="False"/>

        <!-- Grid wraps DataGrid + drag-upload overlay (fills remaining DockPanel space) -->
        <Grid>
        <DataGrid x:Name="FilesGrid"
                  CanUserSortColumns="True"
                  CanUserResizeColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  GridLinesVisibility="Horizontal"
                  HeadersVisibility="Column"
                  FontSize="12"
                  LoadingRow="OnFilesGridLoadingRow"
                  DoubleTapped="OnFilesGridDoubleTapped">
            <DataGrid.ContextMenu>
                <ContextMenu Opening="OnContextMenuOpening">
                    <MenuItem x:Name="MenuOpen"       Header="Open"          Click="OnMenuOpenClicked"/>
                    <MenuItem x:Name="MenuDownloadTo" Header="Download to ▶"/>
                    <MenuItem x:Name="MenuDelete"     Header="Delete"        Click="OnMenuDeleteClicked"/>
                    <Separator/>
                    <MenuItem x:Name="MenuProperties" Header="Properties"    Click="OnMenuPropertiesClicked"/>
                    <Separator/>
                    <MenuItem Header="Refresh" Click="OnRefreshClicked"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="26" CanUserSort="False" CanUserResize="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TypeIcon}" Width="22" TextAlignment="Center"
                                       VerticalAlignment="Center" FontSize="13" Padding="0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" MinWidth="60"
                                    CanUserSort="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="60" MinWidth="40"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedDisplay}" Width="120" MinWidth="60"/>
                <DataGridTextColumn Header="Permissions" Binding="{Binding Permissions}"
                                    Width="84" MinWidth="40" FontFamily="Cascadia Code,Consolas,monospace"/>
                <DataGridTextColumn Header="Owner" Binding="{Binding OwnerDisplay}" Width="50" MinWidth="30"/>
                <DataGridTextColumn Header="Group" Binding="{Binding GroupDisplay}" Width="50" MinWidth="30"/>
                <!-- Filler: absorbs leftover space so all preceding columns have a resize handle -->
                <DataGridTextColumn Header="" Width="*" CanUserSort="False" CanUserResize="False" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Semi-transparent blue overlay shown when dragging files from OS over the non-folder area -->
        <Border x:Name="DropOverlay"
                Background="#402196F3"
                IsHitTestVisible="False"
                IsVisible="False">
            <TextBlock Text="+"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="64"
                       Foreground="#A02196F3"
                       FontWeight="Bold"/>
        </Border>
        </Grid>
    </DockPanel>
</UserControl>
