<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TermThing.Views.SettingsWindow"
        Title="TermThing Settings"
        Width="680" Height="520"
        MinWidth="520" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        RequestedThemeVariant="Dark">

    <DockPanel Margin="12">

        <!-- Bottom OK / Cancel -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,10,0,0">
            <Button x:Name="OkButton"     Content="OK"     MinWidth="80" Click="OnOkClicked"     IsDefault="True"/>
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="80" Click="OnCancelClicked" IsCancel="True"/>
        </StackPanel>

        <TabControl>

            <!-- ============================================================
                 General
                 ============================================================ -->
            <TabItem Header="General">
                <StackPanel Margin="8" Spacing="12">
                    <TextBlock Text="Recent sessions"
                               FontWeight="SemiBold"
                               Margin="0,0,0,2"/>

                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="Show this many recent sessions in the New Session dropdown:"
                                   VerticalAlignment="Center"/>
                        <NumericUpDown x:Name="RecentCountSpinner"
                                       Minimum="1" Maximum="50"
                                       Value="10"
                                       Width="110"
                                       VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Exit"
                               FontWeight="SemiBold"
                               Margin="0,8,0,2"/>

                    <CheckBox x:Name="ConfirmExitCheckBox"
                              Content="Confirm before exiting when sessions are open"/>
                </StackPanel>
            </TabItem>

            <!-- ============================================================
                 Applications
                 ============================================================ -->
            <TabItem Header="Applications">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top"
                               Text="Configure applications for the SFTP browser’s Open With menu. Extensions are comma-separated, e.g. .log, .txt (leave blank to match any). Use {file} in Args as a placeholder for the file path."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="Gray"
                               Margin="0,0,0,8"/>

                    <!-- Built-in editor section -->
                    <Border DockPanel.Dock="Top"
                            BorderBrush="#444"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,8"
                            Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="TermThing Editor" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <TextBlock Text="Default for extensions:" VerticalAlignment="Center" FontSize="11"/>
                                    <TextBox x:Name="BuiltInExtBox"
                                             Width="220"
                                             FontSize="11"
                                             PlaceholderText=".txt, .log  (blank = match any)"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="BuiltInDefaultCheck"
                                      Grid.Column="1"
                                      Content="Default"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Add / Remove buttons for external apps -->
                    <StackPanel DockPanel.Dock="Bottom"
                                Orientation="Horizontal"
                                Spacing="6"
                                Margin="0,8,0,0">
                        <Button x:Name="AddAppButton"    Content="＋ Add"    Click="OnAddAppClicked"/>
                        <Button x:Name="RemoveAppButton" Content="− Remove"  Click="OnRemoveAppClicked"/>
                    </StackPanel>

                    <DataGrid x:Name="AppsGrid"
                              AutoGenerateColumns="False"
                              CanUserSortColumns="False"
                              CanUserResizeColumns="True"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              FontSize="12">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"       Binding="{Binding Name}"         Width="120"/>
                            <DataGridTextColumn Header="App Path"   Binding="{Binding AppPath}"       Width="*"/>
                            <DataGridTextColumn Header="Args"       Binding="{Binding Args}"          Width="90"/>
                            <DataGridTextColumn Header="Extensions" Binding="{Binding ExtensionsRaw}" Width="130"/>
                            <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsDefault}"    Width="60"/>
                            <DataGridTemplateColumn Header="" Width="34" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="…"
                                                Padding="4,2"
                                                FontSize="11"
                                                Tag="{Binding}"
                                                Click="OnBrowseAppClicked"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================
                 Terminal  (placeholder for future options)
                 ============================================================ -->
            <TabItem Header="Terminal">
                <StackPanel Margin="8" Spacing="8">
                    <TextBlock Text="Terminal preferences will appear here in a future release."
                               Foreground="Gray"/>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
