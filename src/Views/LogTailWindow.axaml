<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        x:Class="TermThing.Views.LogTailWindow"
        Title="Tail"
        Width="900" Height="560"
        MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterScreen">

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                Padding="6,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"
                            VerticalAlignment="Center">
                    <ComboBox Name="SyntaxCombo"
                              Width="160"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Syntax highlighting"/>
                    <ToggleButton Name="PauseButton"
                                  Content="⏸ Pause"
                                  Padding="10,4"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Pause/resume tail (incoming lines are buffered while paused)"/>
                    <CheckBox Name="AutoScrollCheck"
                              Content="Auto-scroll"
                              IsChecked="True"
                              VerticalAlignment="Center"/>
                    <Button Name="ClearButton"
                            Content="Clear"
                            Padding="10,4"
                            VerticalAlignment="Center"/>
                </StackPanel>

                <TextBox Name="PathBox"
                         IsReadOnly="True"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0"
                         BorderThickness="0"
                         Background="Transparent"
                         FontFamily="fonts:CascadiaCode#Cascadia Code,Consolas,monospace"
                         FontSize="12"/>
            </DockPanel>
        </Border>

        <TextBlock Name="StatusText"
                   DockPanel.Dock="Bottom"
                   FontSize="11"
                   Padding="8,2"
                   IsVisible="False"
                   Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                   Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>

        <avalonEdit:TextEditor Name="Editor"
                               IsReadOnly="True"
                               ShowLineNumbers="True"
                               FontFamily="fonts:CascadiaCode#Cascadia Code,Consolas,monospace"
                               FontSize="12"
                               WordWrap="False"
                               HorizontalScrollBarVisibility="Auto"
                               VerticalScrollBarVisibility="Auto"/>

    </DockPanel>
</Window>
