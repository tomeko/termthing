<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="TermThing.App"
             RequestedThemeVariant="Dark">

    <Application.Styles>
        <FluentTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml"/>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml"/>
        <!-- Inter's `calt` feature substitutes "digit-x-digit" with the
             multiplication sign — desirable for "1920x1080" prose, wrong for
             hostnames and identifiers. Disable it on text-entry controls (via a
             font swap because TextPresenter doesn't expose FontFeatures) and on
             TextBlocks (where FontFeatures works directly). -->
        <Style Selector="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI, San Francisco, Helvetica Neue, Arial, sans-serif"/>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFeatures" Value="-calt -dlig"/>
        </Style>

        <!-- Remove the white cell selection border from all DataGrids globally -->
        <Style Selector="DataGridCell">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Application.Styles>
</Application>
